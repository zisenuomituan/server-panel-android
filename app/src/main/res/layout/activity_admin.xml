<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/Btn.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="← 返回"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="管理"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout style="@style/Panel">

                <TextView
                    style="@style/PanelTitle"
                    android:text="功能开关" />

                <CheckBox
                    android:id="@+id/cbExec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="启用网页命令行（在详情页对虚拟机执行命令）"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="关闭后所有账号都无法在网页执行命令。"
                    android:textColor="@color/dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout style="@style/Panel">

                <TextView
                    style="@style/PanelTitle"
                    android:text="登记宿主机" />

                <EditText
                    android:id="@+id/hostName"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="名称，如 机房A"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/hostAddr"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="frp 地址"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/hostPort"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="SSH 端口"
                    android:inputType="number" />

                <EditText
                    android:id="@+id/hostUser"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="用户，默认 panel"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/hostUri"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="libvirt URI，默认 qemu:///system"
                    android:inputType="text" />

                <Button
                    android:id="@+id/btnCreateHost"
                    style="@style/Btn.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="生成密钥" />

                <LinearLayout
                    android:id="@+id/hostKeyBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_keybox"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/hostKeyOut"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/green"
                        android:textIsSelectable="true"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="这是唯一的明文展示，请复制保存。密钥 32 位，可被多个账号绑定。"
                        android:textColor="@color/dim"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnCopyKey"
                        style="@style/Btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="复制密钥" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Panel">

                <TextView
                    style="@style/PanelTitle"
                    android:text="用户" />

                <EditText
                    android:id="@+id/nuName"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="用户名"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/nuPass"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="密码，至少 8 位"
                    android:inputType="textPassword" />

                <Spinner
                    android:id="@+id/nuRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="42dp" />

                <EditText
                    android:id="@+id/nuEmail"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="邮箱（可选）"
                    android:inputType="textEmailAddress" />

                <Button
                    android:id="@+id/btnCreateUser"
                    style="@style/Btn.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="新建用户" />

                <LinearLayout
                    android:id="@+id/usersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout style="@style/Panel">

                <TextView
                    style="@style/PanelTitle"
                    android:text="密钥" />

                <LinearLayout
                    android:id="@+id/keysContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:paddingBottom="6dp"
                android:text="@string/attribution"
                android:textColor="@color/dim"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
